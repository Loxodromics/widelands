#version 330

// Attributes.
layout(location = 0) in vec2 attr_position;
layout(location = 1) in vec2 attr_texture_position;
layout(location = 2) in float attr_brightness;

layout(std140) uniform per_program_state {
	float u_z_value;
};

// Outputs.
out vec2 out_texture_position;
out float out_brightness;

void main() {
	out_texture_position = attr_texture_position;
	out_brightness = attr_brightness;
	gl_Position = vec4(attr_position, u_z_value, 1.);
}
