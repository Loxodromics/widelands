#version 330

// Attributes.
layout(location = 0) in vec2 attr_position;
layout(location = 1) in vec4 attr_overlay;

layout(std140) uniform per_program_state {
	float u_z_value;
};

// Output of vertex shader.
out vec4 var_overlay;

void main() {
	var_overlay = attr_overlay;
	gl_Position = vec4(attr_position, u_z_value, 1.);
}
