#version 330

// Attributes.
layout(location = 0) in vec2 attr_position;
layout(location = 1) in vec2 attr_texture_position;
layout(location = 2) in float attr_brightness;

layout(std140) uniform per_program_state {
	float u_z_value;
	float u_max_distance;
	float u_contour_spacing;
	float u_zero_band;
	float u_time;
	float u_cloud_amplitude;
	float u_debug;
	vec4 u_grid;
};

// Output of vertex shader.
out vec2 var_texture_position;
out float var_brightness;
out float var_cloud_shadow;

#include "terrain_noise_params.glsl"
#include "simplex_noise.glsl"
#include "noise_fields.glsl"

/* The distance-field lookup itself is deliberately not computed here. WATER.md
 * §4.2 requires it be sampled per *fragment*: WP-5 warps the sample position,
 * and a displaced lookup is random access, which the attribute pipeline
 * cannot express. Warping at vertex level would only produce a different
 * polygon.
 *
 * The cloud shadow (WP-6) is the opposite case: it depends only on world
 * position and time, both constant per field, so computing it here and
 * interpolating to the fragment stage is visually exact -- the same
 * per-vertex treatment terrain.vp/dither.vp give it, and for the same reason
 * (see terrain_cloud_shadow()'s own comment, terrain_variation.glsl).
 */
void main() {
	var_texture_position = attr_texture_position;
	var_brightness = attr_brightness;
	var_cloud_shadow = cloud_shadow(attr_texture_position, u_time, u_cloud_amplitude);
	gl_Position = vec4(attr_position, u_z_value, 1.);
}
